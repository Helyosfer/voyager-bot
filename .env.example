# Bu dosyayı kopyalayıp adını ".env" yap, sonra değerleri doldur.
# .env dosyasını ASLA kimseyle paylaşma ve GitHub'a yükleme.

# Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Developer Portal > General Information > Application ID
CLIENT_ID=

# İsteğe bağlı: bot sahibine özel komutların (ör. /sunucular) görüneceği kendi
# sunucunun ID'si. Birden fazlaysa virgülle ayır. Diğer komutlar botun eklendiği
# her sunucuda kendiliğinden görünür.
GUILD_IDS=

# İsteğe bağlı: silinen ve düzenlenen mesajların içeriği log kanalına yazılsın.
# 1 yapmadan ÖNCE Developer Portal > Bot > "Message Content Intent" açık olmalı,
# yoksa bot bağlanamaz.
MESAJ_ICERIGI=0

# --- Canlı yayın bildirimleri (/yayin). Kullanmadığın platformu boş bırak. ---

# Twitch ve Kick'in bota haber gönderebilmesi için botun internetten ulaşılan adresi.
# Sonunda / olmadan, ör. https://voyager.ornek.com
YAYIN_ADRESI=

# dev.twitch.tv > Your Console > Applications
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# kick.com > Ayarlar > Developer. Uygulamada webhook adresi: YAYIN_ADRESI + /kick
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Google Cloud Console > YouTube Data API v3 > API anahtarı
YOUTUBE_API_KEY=

# --- Instagram gönderi bildirimleri (/instagram). Kullanmayacaksan boş bırak. ---
# developers.facebook.com > uygulama > Uygulama ayarları > Temel
META_APP_ID=
META_APP_SECRET=
# Graph API Explorer'da üretilen kullanıcı jetonu (instagram_basic,
# instagram_manage_insights, pages_read_engagement, pages_show_list izinleriyle).
# Kısa ömürlü olabilir: bot ilk açılışta uzun ömürlüsüyle değiştirir ve kendisi yeniler.
# Bu yüzden jetonu ürettikten sonra bir saat içinde botu yeniden başlat.
INSTAGRAM_TOKEN=
# İsteğe bağlı: Instagram bildirimlerinin açık olacağı sunucuların ID'leri (virgülle ayır).
# Doldurursan GUILD_IDS'teki sunucular da izinli sayılır.
INSTAGRAM_SUNUCULAR=

# --- Yapay zekâ: soru cevaplama (/sor) ve oyun fırsatı incelemeleri. Kullanmayacaksan boş bırak. ---
# aistudio.google.com > Get API key. YouTube anahtarını burada kullanma; ayrı bir anahtar oluştur.
GEMINI_API_KEY=
# /sor için modelin API'deki adı (AI Studio'da modeli seçip "Get code" ile görülür). Gemma modelleri
# (ör. Gemma 4) çok daha yüksek günlük sınırla gelir ama yavaştır (15-30 sn); sorular için hızlı bir Gemini modeli önerilir.
GEMINI_MODEL=
# İsteğe bağlı: asıl model yoğunken (503) ya da kotası dolduğunda sorunun sorulacağı yedek model(ler);
# birden fazlaysa virgülle ayır, sırayla denenir.
GEMINI_YEDEK_MODEL=
# İsteğe bağlı: oyun incelemelerini yazacak model (yedekle birlikte virgülle ayır). Boşsa /sor modeli kullanılır. İncelemeler günde en fazla
# 60 istek kullanır. Google sınırları model başına saydığı için /sor'dan farklı bir model vermek yükü dağıtır.
GEMINI_INCELEME_MODEL=
# /sor modelinin sınırları: AI Studio > Rate limit sayfasındaki RPD (günlük) ve RPM (dakikalık) değerleri.
# Bot payı kalsın diye bunların %90'ını kullanır. Boşsa 500 ve 15.
GEMINI_GUNLUK=
GEMINI_DAKIKALIK=
# İsteğe bağlı: modelin düşünme düzeyi (minimal, low, medium, high). Boşsa minimal: cevaplar hızlı gelir.
# Model bu ayarı tanımıyorsa bot kendiliğinden ayarsız devam eder.
GEMINI_DUSUNME=
# İsteğe bağlı: /sor komutunu yalnızca bu sunucularda aç (ID'ler, virgülle ayır). Boşsa her sunucuda açıktır;
# günlük kota, soru soran sunucular ve kişiler arasında kendiliğinden paylaştırılır. Oyun incelemeleri bundan
# etkilenmez: her oyun için bir kez yazılır ve her sunucuda gösterilir.
# Doldurursan GUILD_IDS'teki sunucular da izinli sayılır.
GEMINI_SUNUCULAR=
