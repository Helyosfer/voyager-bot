# Bu dosyayı kopyalayıp adını ".env" yap, sonra değerleri doldur.
# .env dosyasını ASLA kimseyle paylaşma ve GitHub'a yükleme.

# Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Developer Portal > General Information > Application ID
CLIENT_ID=

# İsteğe bağlı: bot sahibine özel komutların (ör. /sunucular) görüneceği kendi
# sunucunun ID'si. Birden fazlaysa virgülle ayır. Diğer komutlar botun eklendiği
# her sunucuda kendiliğinden görünür.
GUILD_IDS=

# İsteğe bağlı: silinen ve düzenlenen mesajların içeriği log kanalına yazılsın.
# 1 yapmadan ÖNCE Developer Portal > Bot > "Message Content Intent" açık olmalı,
# yoksa bot bağlanamaz.
MESAJ_ICERIGI=0

# --- Canlı yayın bildirimleri (/yayin). Kullanmadığın platformu boş bırak. ---

# Twitch ve Kick'in bota haber gönderebilmesi için botun internetten ulaşılan adresi.
# Sonunda / olmadan, ör. https://voyager.ornek.com
YAYIN_ADRESI=

# dev.twitch.tv > Your Console > Applications
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# kick.com > Ayarlar > Developer. Uygulamada webhook adresi: YAYIN_ADRESI + /kick
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Google Cloud Console > YouTube Data API v3 > API anahtarı
YOUTUBE_API_KEY=

# --- Instagram gönderi bildirimleri (/instagram). Kullanmayacaksan boş bırak. ---
# developers.facebook.com > uygulama > Uygulama ayarları > Temel
META_APP_ID=
META_APP_SECRET=
# Graph API Explorer'da üretilen kullanıcı jetonu (instagram_basic,
# instagram_manage_insights, pages_read_engagement, pages_show_list izinleriyle).
# Kısa ömürlü olabilir: bot ilk açılışta uzun ömürlüsüyle değiştirir ve kendisi yeniler.
# Bu yüzden jetonu ürettikten sonra bir saat içinde botu yeniden başlat.
INSTAGRAM_TOKEN=
# İsteğe bağlı: Instagram bildirimlerinin açık olacağı sunucuların ID'leri (virgülle ayır).
# GUILD_IDS'teki sunucular zaten izinlidir. İkisi de boşsa özellik her sunucuda açık olur.
INSTAGRAM_SUNUCULAR=

# --- Yapay zekâ ile soru cevaplama (/sor). Kullanmayacaksan boş bırak. ---
# aistudio.google.com > Get API key. YouTube anahtarını burada kullanma; ayrı bir anahtar oluştur.
GEMINI_API_KEY=
# Modelin API'deki adı (AI Studio'da modeli seçip "Get code" ile görülür), ör. gemini-2.5-flash-lite
GEMINI_MODEL=
# İsteğe bağlı: /sor komutunun açık olacağı sunucuların ID'leri (virgülle ayır).
# GUILD_IDS'teki sunucular zaten izinlidir. İkisi de boşsa özellik her sunucuda açık olur.
GEMINI_SUNUCULAR=
